layout {
    cwd "/home/suraj/CultureX/repos"
    tab name="SERVER" hide_floating_panes=true {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane split_direction="vertical" {
            pane cwd="cx-saas-server" name="Server" size="70%" command="doppler" {
                args "run" "--watch"  "--" "npm" "run" "dev"
            }
            pane size="30%" stacked=true {
                pane cwd="cx-saas-dashboard" name="Dashboard" expanded=true command="npm"{
                    args "run" "dev"
                }
                pane cwd="saas-super-admin" name="Super Admin" command="pnpm"{
                    args "dev"
                }
            }
        }
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="MICROSERVICES" {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane split_direction="vertical" {
            pane cwd="cx-analytics-backend" size="65%"  name="Analytics" command="doppler"{
                args "run" "--watch"  "--" "npm" "run" "dev"
            }
            pane size="35%" stacked=true {
                pane cwd="cx-creator-services" expanded=true  name="Global Storage" command="doppler"{
                    args "run" "--watch"  "--" "npm" "run" "dev"
                }
                pane cwd="cx-pdf-generation"  name="PDF Service" command="npm" start_suspended=true {
                    args "run" "dev"
                }
                pane cwd="cx-worker"  name="Worker" command="doppler" start_suspended=true {
                    args "run" "--watch"  "--" "npm" "run" "dev"
                }
            }
        }
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
}
keybinds {
    shared {
        bind "Alt 1" { Run "git" "pull"; }
        bind "Alt 2" { Run "git" "status"; }
        bind "Alt 3" { Run "git" "diff"; }
    }
}

theme "catppuccin-mocha"