layout {
    cwd "/home/suraj/Work/repos"
    tab name="DEV SERVER" hide_floating_panes=true {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane split_direction="vertical" {
            pane cwd="cx-saas-server" size="70%" command="doppler" {
                args "run" "--watch"  "--" "npm" "run" "dev"
            }
            pane size="30%" stacked=true {
                pane cwd="cx-saas-dashboard" expanded=true command="npm"{
                    args "run" "dev"
                }
                pane cwd="saas-super-admin" command="pnpm"{
                    args "dev"
                }
            }
        }
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="DEV MICROSERVICES" {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane split_direction="vertical" {
            pane cwd="cx-analytics-backend" size="65%"  name="cx-analytics-backend" command="doppler"{
                args "run" "--watch"  "--" "npm" "run" "dev"
            }
            pane cwd="cx-creator-services" size="35%" name="cx-creator-services" command="doppler"{
                args "run" "--watch"  "--" "npm" "run" "dev"
            }
        }
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
}
keybinds {
    shared {
        bind "Alt 1" { Run "git" "pull"; }
        bind "Alt 2" { Run "git" "status"; }
        bind "Alt 3" { Run "git" "diff"; }
    }
}

theme "catppuccin-mocha"