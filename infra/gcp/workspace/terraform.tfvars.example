# Copy to terraform.tfvars and fill in real values. Never commit terraform.tfvars.
project_id          = "your-project-id"
ssh_user            = "your-linux-username"
ssh_public_key_path = "~/.ssh/id_ed25519_workspace.pub"
ssh_identity_agent  = "~/.bitwarden-ssh-agent.sock" # Bitwarden desktop SSH agent; remove to use the default agent
machine_type        = "e2-standard-2"                # 2 vCPU / 8 GB; changing it stops and restarts the VM, data kept

# Optional overrides (defaults in variables.tf)
# dotfiles_repo = "git@github.com:<you>/dotfiles.git"   # "" = skip dotfiles on first boot
# region        = "asia-south1"
# zone          = "asia-south1-a"
# name          = "workspace"
# disk_size_gb  = 50   # can only grow; shrinking recreates the VM and wipes the disk
