.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Real variable values (commit *.tfvars.example instead)
*.tfvars
*.tfvars.json
!*.tfvars.example

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan output files
*.tfplan
