#cloud-config
# Cloud-agnostic first-boot bootstrap for a dev workspace VM.
# Rendered by OpenTofu templatefile(): substitutes the username, SSH public key and dotfiles repo URL.
# Holds no secrets. Tailscale is installed here but joined by hand after first login.
# Tools and dotfiles come from install-linux.sh in the dotfiles repo, so the same setup
# can be re-run by hand on an existing VM. Log: /var/log/cloud-init-output.log

users:
  - name: ${username}
    groups: [sudo]
    shell: /bin/bash # install-linux.sh switches it to zsh
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key}

ssh_pwauth: false

package_update: true
package_upgrade: true
packages:
  - git
  - curl

runcmd:
  # Tailscale: installed only; run `sudo tailscale up --ssh` after first login
  - curl -fsSL https://tailscale.com/install.sh | sh
%{ if dotfiles_repo != "" ~}
  # Dotfiles: clone over HTTPS (no GitHub key on the VM yet), run the Linux bootstrap
  # as the user, then switch origin to SSH (the script's own pull needs HTTPS until gh auth)
  - su - ${username} -c 'git clone ${dotfiles_clone_url} ~/Personal/dotfiles && ~/Personal/dotfiles/install-linux.sh; git -C ~/Personal/dotfiles remote set-url origin ${dotfiles_repo}'
%{ endif ~}
